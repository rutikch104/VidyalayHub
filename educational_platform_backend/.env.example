# Copy to .env and fill in values. Never commit real .env to git.

NODE_ENV=development
NODE_PORT=3030

# Production CORS — required when frontend is on Vercel (comma-separated, no spaces)
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://www.yourdomain.com

# Behind nginx / ALB / CloudFront
# TRUST_PROXY=1

# JSON body size (default 1mb)
# JSON_BODY_LIMIT=1mb

# Rate limiting (defaults: 300 req / 15 min per IP in production)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300

# PostgreSQL
POSTGRESQL_DB=vidhyalayhub
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=
POSTGRESQL_HOST=127.0.0.1
POSTGRESQL_DIALECT=postgres

# Connection pool (production defaults: max 20, min 2)
# POSTGRESQL_POOL_MAX=20
# POSTGRESQL_POOL_MIN=2
# POSTGRESQL_POOL_ACQUIRE=30000
# POSTGRESQL_POOL_IDLE=10000

# Auth (required in production)
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_SECRET=change-me-in-production
ACCESS_TOKEN_DSECRET=change-me-in-production

# Multi-tenant SaaS
DEFAULT_TENANT_SLUG=rcpit
PLATFORM_DOMAIN=vidyalayhub.com

# Admin portal — comma-separated emails with platform-wide /api/admin access
# PLATFORM_ADMIN_EMAILS=owner@yourdomain.com

# College staff (user_type=staff + tenant_id) access /api/admin for their college.
# Set ADMIN_PORTAL_OPEN=true only in local dev to bypass (never in production).
# ADMIN_PORTAL_OPEN=false

# Super Admin — separate login; restrict in production
# SUPER_ADMIN_EMAILS=owner@yourdomain.com
# SUPER_ADMIN_OPEN=false
# JWT_EXPIRES_IN=7d
# No refresh-token flow yet — clients re-authenticate when JWT expires.

# SaaS / production hardening
# TENANT_STRICT_MODE=true
# SKIP_SEQUELIZE_SYNC=true
# ENABLE_TENANT_RLS=true

# Backend audit (optional): AUDIT_EMAIL= AUDIT_PASSWORD= AUDIT_BASE_URL=http://127.0.0.1:3030

# Optional: OpenAI / other integrations
# OPENAI_API_KEY=

# ─── Media storage (local default; S3-ready) ─────────────────────
STORAGE_PROVIDER=local
# UPLOAD_ROOT=/var/app/uploads
# MEDIA_PUBLIC_BASE_PATH=/media
# PUBLIC_BASE_URL=https://api.yourdomain.com
# UPLOAD_MAX_POST_BYTES=26214400
# UPLOAD_MAX_AVATAR_BYTES=5242880
# UPLOAD_MAX_COVER_BYTES=8388608
# UPLOAD_MAX_MESSAGE_BYTES=20971520
# UPLOAD_MAX_LIBRARY_BYTES=52428800
# AWS_S3_BUCKET=
# AWS_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_CLOUDFRONT_URL=https://cdn.yourdomain.com
