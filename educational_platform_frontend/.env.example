# Real API — must include /api prefix. Set in Vercel Project → Environment Variables.
VITE_API_BASE_URL=http://localhost:3030/api

# Production example (replace with your AWS API URL):
# VITE_API_BASE_URL=https://api.yourdomain.com/api

# App display name (optional)
# VITE_APP_NAME=VidhyalayHub

# Default college slug for RC Patel launch (multi-tenant)
VITE_DEFAULT_TENANT_SLUG=rcpit

# Mock mode — must be false or unset in production
# VITE_USE_MOCK=false
